# ============================================================
# HapticSync Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git. .env is in .gitignore.
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# These match Supabase's "Direct Connection" credentials.
# Found at: Supabase Dashboard → Project Settings → Database
user=postgres
password=YOUR_DB_PASSWORD_HERE
host=db.YOUR_PROJECT_REF.supabase.co
port=5432
dbname=postgres

# ── Supabase API ─────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API

# Your project's public URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (safe to expose in Flutter)
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ⚠️  SERVICE ROLE KEY — SERVER-SIDE ONLY. NEVER expose to Flutter or commit to Git.
# Used for: creating patient accounts, generating magic links.
# Found at: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# JWT secret for verifying Supabase-issued tokens in FastAPI.
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Application ───────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated, or * for all in dev)
CORS_ORIGINS=*

# ── PIN Onboarding Settings ───────────────────────────────────
PIN_EXPIRY_HOURS=24
PIN_MAX_ATTEMPTS=5
